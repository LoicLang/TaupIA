# ============================================
# Kholleur AI — Variables d'environnement
# ============================================
# Copie ce fichier en .env et remplis les valeurs

# --- Clefs API LLM (au moins une requise) ---
GOOGLE_API_KEY=
CLAUDE_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=

# --- Modeles LLM (optionnel, valeurs par defaut) ---
GEMINI_MODEL=gemini-3-flash-preview
CLAUDE_MODEL=claude-sonnet-4-5-20250929
DEEPSEEK_MODEL=deepseek-chat
KIMI_MODEL=kimi-k2.5

# --- Modeles OCR (optionnel, valeurs par defaut) ---
GEMINI_OCR_MODEL=gemini-3-flash-preview
KIMI_OCR_MODEL=kimi-k2.5

# --- Providers par defaut ---
DEFAULT_AI_PROVIDER=kimi
OCR_PROVIDER=kimi

# --- Providers imposes aux utilisateurs standards ---
FIXED_AI_PROVIDER=deepseek
FIXED_OCR_PROVIDER=kimi

# --- Allowlist de testeurs (peuvent changer les providers) ---
# IDs Clerk (sub) separes par virgules
PROVIDER_OVERRIDE_USER_IDS=
# Emails separes par virgules (optionnel)
PROVIDER_OVERRIDE_EMAILS=

# --- CORS (origines autorisees, separees par des virgules) ---
CORS_ORIGINS=http://localhost:3000

# --- Clerk Auth (requis en production) ---
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
