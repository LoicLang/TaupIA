# ============================================
# Kholleur AI — Variables d'environnement
# ============================================
# Copie ce fichier en .env et remplis les valeurs

# --- Clefs API LLM (au moins une requise) ---
GOOGLE_API_KEY=
CLAUDE_API_KEY=
DEEPSEEK_API_KEY=
KIMI_API_KEY=

# --- Modeles LLM (optionnel, valeurs par defaut) ---
GEMINI_MODEL=gemini-3-flash-preview
CLAUDE_MODEL=claude-sonnet-4-5-20250929
DEEPSEEK_MODEL=deepseek-chat
KIMI_MODEL=kimi-k2.5

# --- Modeles OCR (optionnel, valeurs par defaut) ---
GEMINI_OCR_MODEL=gemini-3-flash-preview
KIMI_OCR_MODEL=kimi-k2.5

# --- Providers par defaut ---
DEFAULT_AI_PROVIDER=kimi
OCR_PROVIDER=kimi

# --- CORS (origines autorisees, separees par des virgules) ---
CORS_ORIGINS=http://localhost:3000

# --- Clerk Auth (requis en production) ---
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
